# Copy to .streamlit/secrets.toml locally, or paste into your host's secrets UI.
# NEVER commit the real file — .gitignore already excludes it.

# --- who may change anything -------------------------------------------
# Generated by `python scripts/set_pin.py`. The PIN itself is never stored.
REFRESH_PIN_SALT = "paste-from-set_pin"
REFRESH_PIN_HASH = "paste-from-set_pin"

# Optional: a password to read the dashboard at all. Without it the page is
# public (read-only). Health data on a public URL is your call to make.
# DASHBOARD_PASSWORD = "something-long"

# --- storage that survives a restart -----------------------------------
# Free hosts have ephemeral disks: a SQLite file vanishes on restart, and
# re-pulling months of Garmin history is exactly the traffic that gets an
# account flagged. Use managed Postgres (Neon or Supabase free tier).
DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# --- Garmin session, exported from your own machine --------------------
# From `python scripts/export_tokens.py`. This lets the host RESUME a session
# instead of logging in to Garmin's SSO from a datacenter IP.
# Deliberately no GARMIN_EMAIL / GARMIN_PASSWORD here: the hosted app runs with
# password login disabled, so it can never attempt a fresh SSO login.
GARMINTOKENS = "paste-the-long-token-blob-here"

# --- conservative Garmin limits for a shared, clickable deployment -----
GARMIN_MIN_INTERVAL = "1.5"
GARMIN_MAX_PER_HOUR = "300"
GARMIN_MAX_PER_DAY = "1500"
GARMIN_MIN_SYNC_INTERVAL = "1800"
GARMIN_BREAKER_COOLDOWN = "3600"

# --- optional AI layer --------------------------------------------------
# Groq's free tier needs no card and works from a hosted app.
AI_BACKEND = "groq"
GROQ_API_KEY = "gsk_..."
GROQ_MODEL = "openai/gpt-oss-120b"

# ...or Anthropic, if you would rather pay for a stronger model.
# AI_BACKEND = "anthropic"
# ANTHROPIC_API_KEY = "sk-ant-..."
# AI_MODEL = "claude-sonnet-5"

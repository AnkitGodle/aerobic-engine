# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Garmin (personal use only) -------------------------------------------
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=
# Cached session tokens, so the app logs in once instead of on every sync.
GARMINTOKENS=.garmin_tokens

# --- Database -------------------------------------------------------------
# Managed Postgres (Neon, Supabase) for anything hosted: a free host's disk is
# ephemeral, and losing the database means re-pulling months of Garmin history —
# exactly the traffic that gets an account flagged. Takes precedence over
# AEROBIC_ENGINE_DB, so local and hosted read the same rows.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Local SQLite fallback, used when DATABASE_URL is empty.
AEROBIC_ENGINE_DB=data/aerobic_engine.db

# --- AI layer -------------------------------------------------------------
# gemini is the recommended default: ~1500 requests/day free, no card.
# A chain, tried in order: the Claude Code CLI (uses a Claude subscription
# rather than a metered key) where it is installed, then Gemini, then Groq.
# An unconfigured provider is skipped when the chain is built, not per call.
AI_BACKEND=claude_cli,gemini,groq
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# GROQ_API_KEY=            # https://console.groq.com/keys  (AI_BACKEND=groq)
# Other supported values for AI_BACKEND, each needing its own key:
#   anthropic (ANTHROPIC_API_KEY) · cerebras (CEREBRAS_API_KEY)
#   openrouter (OPENROUTER_API_KEY) · claude_cli (a Pro/Max login, local only)
#   azure (AZURE_AI_ENDPOINT + AZURE_AI_API_KEY + AZURE_AI_DEPLOYMENT)
#   none  — disables the AI layer; the planner falls back to the rules plan
# Pin a model with AI_MODEL_OVERRIDE; otherwise a per-provider chain is used.

# --- Write PIN ------------------------------------------------------------
# Run `python scripts/set_pin.py` to generate these. The PIN itself is never
# stored — not here, not in the database, not in the browser.
REFRESH_PIN_SALT=
REFRESH_PIN_HASH=

# --- Optional -------------------------------------------------------------
# Read gate for a publicly shared dashboard (the PIN protects writes, not reads).
# DASHBOARD_PASSWORD=

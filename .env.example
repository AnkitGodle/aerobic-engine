# Garmin Connect (personal use only)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Where the cached Garmin session tokens live (avoids re-login / repeated MFA)
GARMINTOKENS=.garmin_tokens

# Database file (IRON_COACH_DB is still read, for older setups)
AEROBIC_ENGINE_DB=data/iron_coach.db

# AI layer. Backend: anthropic | groq | claude_cli | azure | none
AI_BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5

# groq: free tier, no card. Get a key at https://console.groq.com/keys
# openai/gpt-oss-120b is Groq's most capable free production model (131K context,
# structured outputs). Free limits: 30 req/min, 1000/day, 8K TOKENS/min — the
# token cap is the one you will hit, so page summaries are cached and a 429 falls
# back to the rules-only plan rather than retrying.
# AI_BACKEND=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# claude_cli: use a Claude Pro/Max subscription via the Claude Code CLI instead
# of an API key. Needs `npm install -g @anthropic-ai/claude-code` and one `claude`
# login. Local only — the hosted dashboard has no CLI to call.
# AI_BACKEND=claude_cli
# CLAUDE_CLI_BIN=claude
# CLAUDE_CLI_MODEL=
# CLAUDE_CLI_EXTRA_ARGS=
# CLAUDE_CLI_TIMEOUT=180

# Azure AI Foundry alternative (only if AI_BACKEND=azure)
# AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com
# AZURE_AI_API_KEY=...
# AZURE_AI_DEPLOYMENT=claude-sonnet-5

# Optional password gate for the hosted dashboard
# DASHBOARD_PASSWORD=

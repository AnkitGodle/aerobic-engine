# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Garmin (personal use only) -------------------------------------------
GARMIN_EMAIL=you@example.com
# Only needed to mint a new session — every sync uses the cached tokens.
# Leave it blank and export_tokens.py will prompt instead.
GARMIN_PASSWORD=
# Cached session tokens, so the app logs in once instead of on every sync.
GARMINTOKENS=.garmin_tokens

# --- Database -------------------------------------------------------------
# Managed Postgres (Neon, Supabase) for anything hosted: a free host's disk is
# ephemeral, and losing the database means re-pulling months of Garmin history —
# exactly the traffic that gets an account flagged. Takes precedence over
# AEROBIC_ENGINE_DB, so local and hosted read the same rows.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Local SQLite fallback, used when DATABASE_URL is empty.
AEROBIC_ENGINE_DB=data/aerobic_engine.db

# --- AI layer -------------------------------------------------------------
# gemini is the recommended default: ~1500 requests/day free, no card.
# rather than a metered key) where it is installed, then Gemini, then Groq.
# An unconfigured provider is skipped when the chain is built, not per call.
AI_BACKEND=gemini,groq
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# GROQ_API_KEY=            # https://console.groq.com/keys  (AI_BACKEND=groq)
# Other supported values for AI_BACKEND, each needing its own key:
#   anthropic (ANTHROPIC_API_KEY) · cerebras (CEREBRAS_API_KEY)
#   azure (AZURE_AI_ENDPOINT + AZURE_AI_API_KEY + AZURE_AI_DEPLOYMENT)
#   none  — disables the AI layer; the planner falls back to the rules plan
# Pin a model with AI_MODEL_OVERRIDE; otherwise a per-provider chain is used.

# --- Write PIN ------------------------------------------------------------
# Run `python scripts/set_pin.py` to generate these. The PIN itself is never
# stored — not here, not in the database, not in the browser.
REFRESH_PIN_SALT=
REFRESH_PIN_HASH=

# --- Optional -------------------------------------------------------------
# Read gate for a publicly shared dashboard (the PIN protects writes, not reads).
# Read gate. Run `python scripts/set_pin.py --read` to fill these in; with
# them set the dashboard asks for a PIN before showing anything.
# READ_PIN_SALT=
# READ_PIN_HASH=

# --- Who this dashboard belongs to ----------------------------------------
# The four lines that make the app yours rather than someone else's. Blank
# means the thing is simply not shown — no placeholder, no dead icon.
# `python scripts/setup.py` asks for all of these and writes this file for you.
ATHLETE_NAME=
# Every user-facing date is in this zone, not the server's. Streamlit Cloud
# runs on UTC, which is five and a half hours wrong for an evening in India.
LOCAL_TZ=Asia/Kolkata
STRAVA_PROFILE_URL=
INSTAGRAM_PROFILE_URL=
# Blank links to this project instead of a personal profile.
GITHUB_PROFILE_URL=

# --- Messages to your phone (optional) ------------------------------------
# The daily session, and answers when you write back. See core/notify.py for
# the four channels and scripts/whatsapp_webhook.py for the two-way set-up.
NOTIFY_BACKEND=none
# Digits only, country code first. The sidebar chip, the allowlist for incoming
# messages, and the number the daily push goes to.
WHATSAPP_CONTACT=
# From your own Meta app (developers.facebook.com -> WhatsApp).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# Meta signs every webhook delivery with this. Without it, nothing is accepted.
# WHATSAPP_APP_SECRET=
# A string you invent, given to Meta once during the webhook handshake.
# WHATSAPP_VERIFY_TOKEN=
# An approved template name, needed only for a scheduled message that lands
# outside the 24-hour window Meta allows free-form replies in.
# WHATSAPP_TEMPLATE=
# Telegram instead: no templates, no window, no approval, ten minutes.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Housekeeping ---------------------------------------------------------
# off keeps a development run out of the visitor counts. Chrome's headless mode
# sends the same user agent as the desktop browser, so the string alone cannot
# tell a screenshot script from a person.
VISIT_COUNTING=on
# Salts the visitor device hash. Any random string.
# VISIT_SALT=
